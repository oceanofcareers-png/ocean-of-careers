# Copy to .env.local for development; set the same names in Vercel → Settings → Environment Variables.

# Admin login
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SESSION_SECRET=at-least-32-random-characters

# Added automatically when you connect the integrations in Vercel → Storage:
# Upstash Redis (content)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Vercel Blob (images)
BLOB_READ_WRITE_TOKEN=
